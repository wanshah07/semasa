 {
  "id": "rl:kinetic-type",
  "name": "Kinetic type",
  "group": "Motion patterns",
  "tags": [],
  "look": "The headline is built word by word (a rise, a slide, a slam), then one slot swaps two to five words."
 },
 {
  "id": "rl:blur-in-text",
  "name": "Blur in text",
  "group": "Motion patterns",
  "tags": [],
  "look": "Hero words sharpen out of a blur and rise slightly, one after another."
 },
 {
  "id": "rl:mask-reveal",
  "name": "Mask reveal",
  "group": "Motion patterns",
  "tags": [],
  "look": "Lines of text rise from behind their own edge in sequence; pictures are uncovered by a moving clip edge."
 },
 {
  "id": "rl:highlighter",
  "name": "Highlighter",
  "group": "Motion patterns",
  "tags": [],
  "look": "A marker stroke sweeps behind the key words as they come into view."
 },
 {
  "id": "rl:typewriter",
  "name": "Typewriter",
  "group": "Motion patterns",
  "tags": [],
  "look": "Text is typed one character at a time behind a caret, pausing at commas and full stops."
 },
 {
  "id": "rl:text-scramble",
  "name": "Text scramble",
  "group": "Motion patterns",
  "tags": [],
  "look": "Letters flicker through random characters and settle left to right on the real text."
 },
 {
  "id": "rl:stamp",
  "name": "Stamp",
  "group": "Motion patterns",
  "tags": [],
  "look": "An element accelerates in, squashes on contact and settles at a slight tilt, like an inked stamp."
 },
 {
  "id": "rl:pop",
  "name": "Pop",
  "group": "Motion patterns",
  "tags": [],
  "look": "A springy scale-in on a damped spring, with the fade finished early."
 },
 {
  "id": "rl:rise",
  "name": "Rise",
  "group": "Motion patterns",
  "tags": [],
  "look": "Elements enter from below with the fade landing early; a stagger of at most eight steps."
 },
 {
  "id": "rl:staggered-list",
  "name": "Staggered list",
  "group": "Motion patterns",
  "tags": [],
  "look": "Rows arrive one after another and a highlight moves from row to row."
 },
 {
  "id": "rl:bars-count-up",
  "name": "Bars and count-up",
  "group": "Motion patterns",
  "tags": [],
  "look": "Bars spring up from the baseline while each value counts up to its figure."
 },
 {
  "id": "rl:donut-gauge",
  "name": "Donut and gauge",
  "group": "Motion patterns",
  "tags": [],
  "look": "One pen draws the donut with gaps, the total counts up, and a gauge needle settles."
 },
 {
  "id": "rl:line-area",
  "name": "Line and area",
  "group": "Motion patterns",
  "tags": [],
  "look": "A pen draws the line chart with a dot on its tip, the area is wiped in, and notes land."
 },
 {
  "id": "rl:odometer",
  "name": "Odometer",
  "group": "Motion patterns",
  "tags": [],
  "look": "Digits roll like counter wheels, the last digit spinning most."
 },
 {
  "id": "rl:match-checklist",
  "name": "Match checklist",
  "group": "Motion patterns",
  "tags": [],
  "look": "Rows tick in order: the circle fills, the check draws, the row brightens."
 },
 {
  "id": "rl:step-indicator",
  "name": "Step indicator",
  "group": "Motion patterns",
  "tags": [],
  "look": "Steps joined by a line; a step ticks and the line fills to the next."
 },
 {
  "id": "rl:curve-route",
  "name": "Curve route",
  "group": "Motion patterns",
  "tags": [],
  "look": "A route draws along a curve, stops pop in, and a marker rides the line."
 },
 {
  "id": "rl:paper-diorama",
  "name": "Paper diorama build",
  "group": "Motion patterns",
  "tags": [],
  "look": "A cut-paper scene builds back to front; layers land and upright pieces pop up on hinges."
 },
 {
  "id": "rl:exploded-view",
  "name": "Exploded view",
  "group": "Motion patterns",
  "tags": [],
  "look": "Isometric layers lift apart with labels sliding out, then close up again."
 },
 {
  "id": "rl:depth-parallax",
  "name": "Depth parallax",
  "group": "Motion patterns",
  "tags": [],
  "look": "Layers shift by different amounts so near things move more than far things."
 },
 {
  "id": "rl:dolly-in",
  "name": "Dolly in",
  "group": "Motion patterns",
  "tags": [],
  "look": "Near layers grow fast and leave the frame while far layers barely change."
 },
 {
  "id": "rl:rack-focus",
  "name": "Rack focus",
  "group": "Motion patterns",
  "tags": [],
  "look": "Focus pulls from a near layer to a far one as the two swap blur."
 },
 {
  "id": "rl:match-cut",
  "name": "Match cut",
  "group": "Motion patterns",
  "tags": [],
  "look": "A shape in one scene cuts to a matching shape in the next, both zooming on one point."
 },
 {
  "id": "rl:push-transition",
  "name": "Push transition",
  "group": "Motion patterns",
  "tags": [],
  "look": "The next scene pushes the current one off the frame."
 },
 {
  "id": "rl:wipe",
  "name": "Wipe",
  "group": "Motion patterns",
  "tags": [],
  "look": "The next scene replaces the current one behind a moving edge: a line, a clock hand or an iris."
 },
 {
  "id": "rl:shape-transition",
  "name": "Shape transition",
  "group": "Motion patterns",
  "tags": [],
  "look": "A solid shape sweeps in to cover the frame, the scene changes, and the shape moves on."
 },
 {
  "id": "rl:light-sweep",
  "name": "Light sweep",
  "group": "Motion patterns",
  "tags": [],
  "look": "A band of light crosses a card or a logo in one pass."
 },
 {
  "id": "rl:freeze-frame",
  "name": "Freeze frame",
  "group": "Motion patterns",
  "tags": [],
  "look": "The action stops on its key frame, a flash, the colour drains, a label lands, then it resumes."
 },
 {
  "id": "rl:stop-motion",
  "name": "Stop-motion",
  "group": "Motion patterns",
  "tags": [],
  "look": "Movement jumps pose to pose at eight frames a second, like a hand-moved paper model."
 },
 {
  "id": "rl:squash-stretch",
  "name": "Squash and stretch",
  "group": "Motion patterns",
  "tags": [],
  "look": "Objects stretch in flight and squash on contact."
 },
 {
  "id": "rl:film-grain",
  "name": "Film grain",
  "group": "Motion patterns",
  "tags": [],
  "look": "Fine noise over the picture that jumps about twelve times a second."
 },
 {
  "id": "rl:duotone",
